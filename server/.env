# Environment
PROJECT_ROOT=${PWD}
PROJECT_NAME=server
PROJECT_ENVIRONMENT=dev

# Database
DB_ROOT=${PROJECT_ROOT}/db
DB_MS=mysql
DB_NAME=pawsitivity
DB_CONTAINER=${PROJECT_ENVIRONMENT}_${DB_NAME}_${DB_MS}
DB_HOST=localhost
DB_PORT=3306
DB_URL=jdbc:${DB_MS}://${DB_HOST}:${DB_PORT}/${DB_NAME}
DB_USER=root
DB_PASS=root

# Application
APP_NAME=Pawsitivity
APP_MAIN=${PROJECT_ROOT}/src/main/java/com/pawsitivity/server/ServerApplication.java